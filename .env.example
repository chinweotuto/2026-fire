# Database Configuration
DATABASE_URL=sqlite:///./sports_prediction.db
# For PostgreSQL production:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sports_prediction

# Environment & Application Settings
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=dev-secret-key-change-in-production-1234567890

# Storage Directories
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
ARTIFACTS_DIR=./artifacts
MODELS_DIR=./artifacts/models

# Data Sufficiency Thresholds
MIN_SAMPLES_FOOTBALL_1X2=100
MIN_SAMPLES_FOOTBALL_GOALS=100
MIN_SAMPLES_BASKETBALL=100
MIN_SAMPLES_TENNIS=100
